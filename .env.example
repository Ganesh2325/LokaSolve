# Local development placeholders only. Never put real secrets here.
# Copy to .env. The application does not override variables that are already set.

ENV=development
HTTP_ADDR=:8080
AUTO_MIGRATE=true

# Superuser connection used only to apply migrations and the optional demo seed.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/lokasolve?sslmode=disable

# Application connection. This role is not a superuser and is subject to row-level security.
DATABASE_URL=postgres://lokasolve_app:lokasolve_app@localhost:5432/lokasolve?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# Required. Use at least 32 random characters. The process refuses to start in production
# when this still contains "change-me".
AUTH_TOKEN_SECRET=change-me-to-a-random-string-at-least-32-chars

# Used only to hash one-time passwords. Not a user password.
OTP_PEPPER=change-me-otp-pepper-at-least-32-chars

# Never enable this in production. It does not return codes in API responses.
OTP_DEV_EXPOSE=false

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Optional labeled demo accounts. The password is read by cmd/seed and is not written into git.
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=change-me-demo-only
DEMO_ADMIN_EMAIL=demo.admin@lokasolve.test

# Local object storage (MinIO). Not used by Stage 1 requests.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lokasolve-media
S3_ACCESS_KEY=lokasolve
S3_SECRET_KEY=lokasolve-dev-only
S3_REGION=us-east-1

# The browser talks to Next.js. Next.js proxies /api to the gateway.
# The gateway proxies /api/v1 to the Go API. Do not point the browser at :8080.
API_PROXY_TARGET=http://127.0.0.1:8088
NEXT_PUBLIC_APP_NAME=LokaSolve

# Python AI skeleton. No model provider is configured in Stage 1.
AI_HTTP_ADDR=:8090
AI_SERVICE_URL=http://127.0.0.1:8090
